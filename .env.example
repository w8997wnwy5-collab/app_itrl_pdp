# Copia questo file in .env (o imposta le variabili sul tuo hosting).

# Porta HTTP del server (default 3001: in sviluppo Vite su 5173 inoltra /api a 3001)
# PORT=3000

# Cartella del database SQLite (default ./data — fai il backup di questa cartella!)
# DATA_DIR=./data

# Indirizzo pubblico dell'app, es. https://sfida.miaazienda.it
PUBLIC_URL=

# Codice invito fisso (facoltativo). Se vuoto ne viene generato uno, visibile nel pannello organizzatore.
INVITE_CODE=

# --- Claude (facoltativo): avatar dalla foto + Gazzetta della Bilancia scritta dall'AI ---
ANTHROPIC_API_KEY=
# Modello usato (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- Notifiche push (facoltativo) ---
# Se vuote, le chiavi VAPID vengono generate al primo avvio e salvate nel database.
# Per generarle a mano: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto per i servizi push (mailto: o https://)
VAPID_SUBJECT=mailto:tuo.nome@azienda.it

# Notifiche programmate (promemoria, sfottò, Gazzetta): 1 = attive
SCHEDULER=1

# Dietro un proxy HTTPS (Render, Railway, Fly, nginx, Caddy...) lascia i default in produzione.
# COOKIE_SECURE=1
# TRUST_PROXY=1
